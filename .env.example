# Copy to .env. Only GEMINI_API_KEY is required; everything else has a working default.

# --- model provider (free tier) ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Tried in order; a rate-limited or unavailable model hands over to the next.
LLM_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Or any OpenAI-compatible endpoint (Groq, OpenRouter, a local Ollama):
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# LLM_MODELS=llama-3.3-70b-versatile

# --- services -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@localhost:5434/codepilot
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173
# Set to require `Authorization: Bearer <token>` on every request.
API_TOKEN=

# --- sandbox ------------------------------------------------------------------------------
SANDBOX_IMAGE=codepilot-sandbox:latest
SANDBOX_NETWORK=codepilot-sandbox
EGRESS_PROXY_URL=http://egress-proxy:3128
# SANDBOX_RUNTIME=runsc        # run sandboxes under gVisor, if installed
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
SANDBOX_WORKSPACE_MB=512

# --- execution budget per task --------------------------------------------------------------
MAX_LLM_CALLS=90
MAX_TOTAL_TOKENS=2000000
MAX_TOOL_CALLS=250
MAX_WALL_SECONDS=1800
MAX_DEBUG_ITERATIONS=3
MAX_REVIEW_ROUNDS=1
